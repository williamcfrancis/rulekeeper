# Run from the repository root. No key is needed for source-excerpt mode.
RULEKEEPER_PROVIDER=evidence
# For llama.cpp or Ollama, set provider=local and start a local compatible server.
RULEKEEPER_LOCAL_BASE_URL=http://127.0.0.1:8081/v1
RULEKEEPER_LOCAL_MODEL=qwen3-4b
# For the hosted provider, set provider=openai and explicitly choose your model.
RULEKEEPER_OPENAI_MODEL=
OPENAI_API_KEY=
RULEKEEPER_RERANK=true
# Dungeon Master uses gpt-5.6-sol and the key entered in the app for this tab.
# It does not use OPENAI_API_KEY or the rules-answer provider above.
# For a private deployment, add your exact hostname (JSON array); avoid '*'.
RULEKEEPER_ALLOWED_HOSTS=["localhost", "127.0.0.1", "[::1]"]
